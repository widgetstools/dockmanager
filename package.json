{
  "name": "dock-manager-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && npm run build:all",
    "build:core": "npm run build --workspace=@widgetstools/dock-manager-core",
    "build": "npm run build --workspace=@widgetstools/react-dock-manager",
    "build:angular": "npm run build --workspace=@widgetstools/angular-dock-manager",
    "build:angular-demo": "npm run build --workspace=angular-demo",
    "build:all": "npm run build:core && npm run build && npm run build:angular && npm run build --workspace=demo && npm run build:angular-demo && npm run build --workspace=trading-app",
    "dev": "npm run dev --workspace=demo",
    "dev:angular": "npm run dev --workspace=angular-demo",
    "test": "npm run test --workspace=@widgetstools/react-dock-manager",
    "test:coverage": "npm run test:coverage --workspace=@widgetstools/react-dock-manager",
    "clean": "npm run clean --workspaces --if-present",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@angular/compiler": "21.0.0",
    "@angular/compiler-cli": "21.0.0",
    "@angular/core": "21.0.0",
    "@angular/common": "21.0.0",
    "@angular/platform-browser": "21.0.0",
    "@angular/platform-browser-dynamic": "21.0.0",
    "rxjs": "7.8.1",
    "zone.js": "0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
