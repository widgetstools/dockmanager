{
  "name": "dock-manager-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@widgetstools/react-dock-manager",
    "build:angular": "npm run build --workspace=@widgetstools/angular-dock-manager",
    "build:angular-demo": "npm run build --workspace=angular-demo",
    "build:core": "npm run build --workspace=@widgetstools/dock-manager-core",
    "build:lit": "npm run build --workspace=@widgetstools/lit-dock-manager",
    "build:lit-all": "npm run build:core && npm run build:lit",
    "build:react-lit": "npm run build --workspace=@widgetstools/react-dock-manager-lit",
    "build:angular-lit": "npm run build --workspace=@widgetstools/angular-dock-manager-lit",
    "dev": "npm run dev --workspace=demo",
    "dev:angular": "npm run dev --workspace=angular-demo",
    "dev:lit": "npm run dev --workspace=demo-lit",
    "dev:react-lit": "npm run dev --workspace=demo-react-lit",
    "dev:angular-lit": "npm run dev --workspace=demo-angular-lit",
    "build:demo-angular-lit": "npm run build --workspace=demo-angular-lit",
    "test": "npm run test --workspace=@widgetstools/react-dock-manager",
    "test:coverage": "npm run test:coverage --workspace=@widgetstools/react-dock-manager",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@angular/compiler": "21.0.2",
    "@angular/compiler-cli": "21.0.2",
    "@angular/core": "21.0.2",
    "@angular/common": "21.0.2",
    "@angular/platform-browser": "21.0.2",
    "@angular/platform-browser-dynamic": "21.0.2",
    "rxjs": "7.8.1",
    "zone.js": "0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
